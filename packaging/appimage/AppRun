#!/usr/bin/env bash
# SoundOrbit smart AppImage launcher (fully automatic)
# - Detect AMD / NVIDIA / Intel and install matching packages (no prompts)
# - Isolated venv + PYTHONNOUSERSITE (avoid pip conflicts)
# - Auto GL backend fallbacks (x11 / software)
# - Install GNOME/app menu entry on first run
set -euo pipefail

HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
APP_ROOT="$HERE/usr/share/sound-orbit"
# shellcheck source=/dev/null
source "$HERE/usr/share/sound-orbit-runtime/gpu-detect.sh" 2>/dev/null \
  || source "$APP_ROOT/packaging/appimage/gpu-detect.sh" 2>/dev/null \
  || true

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sound-orbit"
BIN_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"
APP_MENU_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
ICON256_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
VENV_DIR="${SOUNDORBIT_VENV:-$DATA_DIR/venv}"
STAMP_FILE="$DATA_DIR/env.stamp"
SETUP_STAMP="$DATA_DIR/setup.stamp"
VERSION_FILE="$APP_ROOT/src/soundorbit/__init__.py"
export PATH="${HERE}/usr/bin:/usr/bin:/bin:${PATH:-}"

# Fully automatic by default (SOUNDORBIT_INTERACTIVE=1 to ask)
AUTO="${SOUNDORBIT_AUTO:-1}"
INTERACTIVE="${SOUNDORBIT_INTERACTIVE:-0}"

die() { echo "error: $*" >&2; exit 1; }
log() { echo "==> $*" >&2; }

app_version() {
  if [[ -f "$VERSION_FILE" ]]; then
    sed -n 's/^__version__ *= *"\([^"]*\)".*/\1/p' "$VERSION_FILE" | head -1
  else
    echo "0.0.0"
  fi
}

# --- GPU ---
if declare -F soundorbit_gpu_detect >/dev/null 2>&1; then
  GPU_ALL="$(soundorbit_gpu_detect)"
  GPU_PRIMARY="$(soundorbit_gpu_primary)"
else
  GPU_ALL="UNKNOWN"
  GPU_PRIMARY="UNKNOWN"
fi
log "GPU detect: ${GPU_ALL} (primary=${GPU_PRIMARY})"

# --- packages ---
# NOTE: Do NOT list pipewire/pipewire-pulse if already installed (CachyOS
# rebuilds like 1.6.8-1.1 get "downgraded" by Arch repos and break deps).
pkgs_base_arch=(
  gtk4 libadwaita
  python python-gobject python-cairo python-numpy python-opengl python-pip
  mesa libepoxy libglvnd
  gobject-introspection
)
# Audio tools only if missing (see filter_missing_arch_pkgs)
pkgs_audio_arch=(pipewire-pulse)
pkgs_amd_arch=(mesa-utils vulkan-radeon libva-mesa-driver mesa-vdpau)
pkgs_nvidia_arch=(nvidia-utils egl-wayland libvdpau)
pkgs_intel_arch=(mesa-utils vulkan-intel intel-media-driver libva)

pkgs_base_deb=(
  python3 python3-gi python3-gi-cairo python3-numpy python3-opengl python3-pip python3-venv
  gir1.2-gtk-4.0 gir1.2-adw-1 libgtk-4-1 libadwaita-1-0
  pipewire pipewire-pulse pulseaudio-utils
  libgl1 libepoxy0 libglvnd0 mesa-utils
)
pkgs_amd_deb=(mesa-vulkan-drivers libgl1-mesa-dri)
pkgs_intel_deb=(mesa-vulkan-drivers intel-media-va-driver libgl1-mesa-dri)

collect_arch_pkgs() {
  local p=("${pkgs_base_arch[@]}")
  echo " $GPU_ALL " | grep -q ' AMD ' && p+=("${pkgs_amd_arch[@]}")
  echo " $GPU_ALL " | grep -q ' NVIDIA ' && p+=("${pkgs_nvidia_arch[@]}")
  echo " $GPU_ALL " | grep -q ' INTEL ' && p+=("${pkgs_intel_arch[@]}")
  # pipewire-pulse only when completely missing (never reinstall/downgrade)
  if ! pacman -Q pipewire-pulse >/dev/null 2>&1 && ! command -v parec >/dev/null 2>&1; then
    p+=("${pkgs_audio_arch[@]}")
  fi
  printf '%s\n' "${p[@]}" | awk '!a[$0]++'
}

# Only packages that are not installed at all (avoids CachyOS downgrades)
filter_missing_arch_pkgs() {
  local p out=()
  for p in "$@"; do
    if pacman -Q "$p" >/dev/null 2>&1; then
      continue
    fi
    out+=("$p")
  done
  if [[ ${#out[@]} -gt 0 ]]; then
    printf '%s\n' "${out[@]}"
  fi
}

collect_deb_pkgs() {
  local p=("${pkgs_base_deb[@]}")
  echo " $GPU_ALL " | grep -q ' AMD ' && p+=("${pkgs_amd_deb[@]}")
  echo " $GPU_ALL " | grep -q ' INTEL ' && p+=("${pkgs_intel_deb[@]}")
  if echo " $GPU_ALL " | grep -q ' NVIDIA '; then
    p+=(libglvnd0 libegl1 libgles2)
  fi
  printf '%s\n' "${p[@]}" | awk '!a[$0]++'
}

collect_dnf_pkgs() {
  local p=(
    python3 python3-gobject python3-cairo python3-numpy python3-pyopengl python3-pip
    gtk4 libadwaita
    pipewire pipewire-pulseaudio pulseaudio-utils
    mesa-libGL mesa-libEGL libepoxy
  )
  echo " $GPU_ALL " | grep -q ' AMD ' && p+=(mesa-dri-drivers mesa-vulkan-drivers)
  echo " $GPU_ALL " | grep -q ' INTEL ' && p+=(mesa-dri-drivers mesa-vulkan-drivers intel-media-driver)
  echo " $GPU_ALL " | grep -q ' NVIDIA ' && p+=(libglvnd egl-wayland)
  printf '%s\n' "${p[@]}" | awk '!a[$0]++'
}

run_privileged() {
  # $@ = command
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
    return
  fi
  if command -v pkexec >/dev/null 2>&1; then
    pkexec "$@" && return
  fi
  if command -v sudo >/dev/null 2>&1; then
    sudo "$@" && return
  fi
  log "warning: no pkexec/sudo — cannot install system packages automatically"
  return 1
}

install_host_deps() {
  if [[ "${SOUNDORBIT_SKIP_PKGS:-0}" == "1" ]]; then
    log "skip package install (SOUNDORBIT_SKIP_PKGS=1)"
    return 0
  fi

  if command -v pacman >/dev/null 2>&1; then
    mapfile -t allp < <(collect_arch_pkgs)
    mapfile -t pkgs < <(filter_missing_arch_pkgs "${allp[@]}")
    if [[ ${#pkgs[@]} -eq 0 ]]; then
      log "pacman: all required packages already installed (no downgrade)"
      return 0
    fi
    log "pacman install ONLY missing packages for GPU [$GPU_ALL]:"
    printf '  %s\n' "${pkgs[@]}" >&2
    # --needed still helps; we already filtered installed names
    run_privileged pacman -S --needed --noconfirm "${pkgs[@]}" || {
      log "warning: pacman install failed (continuing with what is already installed)"
      return 0
    }
    return 0
  fi
  if command -v apt-get >/dev/null 2>&1; then
    mapfile -t pkgs < <(collect_deb_pkgs)
    log "apt install for GPU [$GPU_ALL]…"
    run_privileged bash -c "apt-get update -qq && apt-get install -y ${pkgs[*]}" || return 1
    return 0
  fi
  if command -v dnf >/dev/null 2>&1; then
    mapfile -t pkgs < <(collect_dnf_pkgs)
    log "dnf install for GPU [$GPU_ALL]…"
    run_privileged dnf install -y "${pkgs[@]}" || return 1
    return 0
  fi
  log "warning: unknown package manager — install GTK4/Mesa/NVIDIA stack manually"
  return 1
}

host_python_ok() {
  command -v python3 >/dev/null 2>&1 || return 1
  PYTHONNOUSERSITE=1 python3 - <<'PY' 2>/dev/null
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw  # noqa: F401
PY
}

ensure_venv() {
  local ver need_rebuild=0
  ver="$(app_version)"
  mkdir -p "$DATA_DIR"
  export PYTHONNOUSERSITE=1

  if [[ ! -x "$VENV_DIR/bin/python" ]]; then
    need_rebuild=1
  elif [[ ! -f "$STAMP_FILE" ]] || [[ "$(cat "$STAMP_FILE" 2>/dev/null || true)" != "$ver|$GPU_PRIMARY" ]]; then
    need_rebuild=1
  fi

  if [[ "$need_rebuild" -eq 1 ]]; then
    log "venv → $VENV_DIR (system-site-packages + isolated numpy/PyOpenGL)"
    python3 -m venv --system-site-packages --clear "$VENV_DIR"
    "$VENV_DIR/bin/python" -m pip install --disable-pip-version-check -q --upgrade pip wheel
    "$VENV_DIR/bin/python" -m pip install --disable-pip-version-check -q \
      "numpy>=1.24" "PyOpenGL>=3.1.0"
    printf '%s\n' "$ver|$GPU_PRIMARY" >"$STAMP_FILE"
    log "venv ready"
  fi
}

venv_deps_ok() {
  export PYTHONNOUSERSITE=1
  [[ -x "$VENV_DIR/bin/python" ]] || return 1
  "$VENV_DIR/bin/python" - <<'PY' 2>/dev/null
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw  # noqa: F401
import numpy  # noqa: F401
from OpenGL import GL  # noqa: F401
PY
}

# --- desktop menu ---
install_app_menu() {
  mkdir -p "$BIN_DIR" "$APP_MENU_DIR" "$ICON_DIR" "$ICON256_DIR"

  local launcher_target
  if [[ -n "${APPIMAGE:-}" && -f "${APPIMAGE}" ]]; then
    launcher_target="$APPIMAGE"
    # Stable launcher that always runs this AppImage
    cat >"$BIN_DIR/sound-orbit" <<EOF
#!/usr/bin/env bash
# Generated by SoundOrbit AppImage setup
exec "$APPIMAGE" "\$@"
EOF
  else
    # Dev / extracted mode: run payload with venv if present
    cat >"$BIN_DIR/sound-orbit" <<EOF
#!/usr/bin/env bash
export PYTHONNOUSERSITE=1
if [[ -x "$VENV_DIR/bin/python" ]]; then
  exec "$VENV_DIR/bin/python" "$APP_ROOT/sound-orbit" "\$@"
fi
exec python3 "$APP_ROOT/sound-orbit" "\$@"
EOF
    launcher_target="$BIN_DIR/sound-orbit"
  fi
  chmod +x "$BIN_DIR/sound-orbit"

  # Icons
  if [[ -f "$APP_ROOT/data/icons/io.github.yomiplush.SoundOrbit.svg" ]]; then
    cp -f "$APP_ROOT/data/icons/io.github.yomiplush.SoundOrbit.svg" \
      "$ICON_DIR/io.github.yomiplush.SoundOrbit.svg"
  fi
  if [[ -f "$HERE/sound-orbit.png" ]]; then
    cp -f "$HERE/sound-orbit.png" "$ICON256_DIR/io.github.yomiplush.SoundOrbit.png"
  elif [[ -f "$HERE/usr/share/icons/hicolor/256x256/apps/sound-orbit.png" ]]; then
    cp -f "$HERE/usr/share/icons/hicolor/256x256/apps/sound-orbit.png" \
      "$ICON256_DIR/io.github.yomiplush.SoundOrbit.png"
  fi

  # Desktop entry
  cat >"$APP_MENU_DIR/io.github.yomiplush.SoundOrbit.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=サウンドオービット
Name[en]=SoundOrbit
GenericName=3D Sound Visualizer
GenericName[ja]=3Dサウンドビジュアライザー
Comment=Fullscreen 3D visualizer that reacts to system audio
Comment[ja]=PCで再生中の音に反応する全画面3Dサウンドビジュアライザー
Exec=$BIN_DIR/sound-orbit
Icon=io.github.yomiplush.SoundOrbit
Terminal=false
Categories=AudioVideo;Audio;
Keywords=visualizer;audio;sound;music;3D;AppImage;
StartupNotify=true
StartupWMClass=io.github.yomiplush.SoundOrbit
EOF

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APP_MENU_DIR" 2>/dev/null || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor" 2>/dev/null || true
  fi
  log "app menu installed → サウンドオービット ($BIN_DIR/sound-orbit)"
  log "  target: $launcher_target"
}

apply_gpu_env() {
  case "$GPU_PRIMARY" in
    NVIDIA)
      if [[ -e /dev/nvidia0 ]]; then
        export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
      fi
      export __GL_THREADED_OPTIMIZATIONS="${__GL_THREADED_OPTIMIZATIONS:-1}"
      ;;
    AMD|INTEL)
      if [[ -z "${__GLX_VENDOR_LIBRARY_NAME:-}" ]]; then
        unset __GLX_VENDOR_LIBRARY_NAME 2>/dev/null || true
      fi
      ;;
  esac
}

# Soft software-GL env that works on NVIDIA hosts (must force mesa, not nvidia GLX/EGL)
software_gl_env() {
  local mesa_egl=""
  for f in /usr/share/glvnd/egl_vendor.d/*mesa*.json /usr/share/glvnd/egl_vendor.d/*Mesa*.json; do
    [[ -f "$f" ]] && mesa_egl="$f" && break
  done
  if [[ -n "$mesa_egl" ]]; then
    echo "SOUNDORBIT_GL_MODE=software SOUNDORBIT_ALPHA=0 LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe __GLX_VENDOR_LIBRARY_NAME=mesa MESA_LOADER_DRIVER_OVERRIDE=llvmpipe __EGL_VENDOR_LIBRARY_FILENAMES=$mesa_egl GDK_BACKEND=wayland"
  else
    echo "SOUNDORBIT_GL_MODE=software SOUNDORBIT_ALPHA=0 LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe __GLX_VENDOR_LIBRARY_NAME=mesa MESA_LOADER_DRIVER_OVERRIDE=llvmpipe GDK_BACKEND=wayland"
  fi
}

nvidia_wayland_env() {
  local nv_egl=""
  for f in /usr/share/glvnd/egl_vendor.d/*nvidia*.json /usr/share/glvnd/egl_vendor.d/*NVIDIA*.json; do
    [[ -f "$f" ]] && nv_egl="$f" && break
  done
  if [[ -n "$nv_egl" ]]; then
    echo "SOUNDORBIT_GL_MODE=nvidia-wayland SOUNDORBIT_ALPHA=0 GDK_BACKEND=wayland __GLX_VENDOR_LIBRARY_NAME=nvidia __GL_THREADED_OPTIMIZATIONS=1 __EGL_VENDOR_LIBRARY_FILENAMES=$nv_egl"
  else
    echo "SOUNDORBIT_GL_MODE=nvidia-wayland SOUNDORBIT_ALPHA=0 GDK_BACKEND=wayland __GLX_VENDOR_LIBRARY_NAME=nvidia __GL_THREADED_OPTIMIZATIONS=1"
  fi
}

# Quick GL probe (creates tiny GLArea, exits 0 if context works)
probe_gl() {
  # Usage: probe_gl KEY=VAL KEY=VAL ...
  export PYTHONNOUSERSITE=1
  local logf="${DATA_DIR}/gl_probe.log"
  mkdir -p "$DATA_DIR"
  # shellcheck disable=SC2086
  if env "$@" "$VENV_DIR/bin/python" - <<'PY' >"$logf" 2>&1
import os, sys
# Env must already be set by `env KEY=VAL` before this process starts
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, GLib

ok = {"v": False, "err": ""}

app = Adw.Application(application_id="io.github.yomiplush.SoundOrbit.glprobe")

def activate(a):
    w = Gtk.ApplicationWindow(application=a, title="probe")
    gl = Gtk.GLArea()
    gl.set_required_version(3, 3)
    gl.set_has_depth_buffer(True)
    if hasattr(gl, "set_has_alpha"):
        try:
            gl.set_has_alpha(True)
        except Exception:
            pass
    def on_realize(area):
        try:
            area.make_current()
            err = area.get_error()
            if err is None:
                ok["v"] = True
            else:
                ok["err"] = err.message
        except Exception as e:
            ok["err"] = str(e)
            ok["v"] = False
        a.quit()
    gl.connect("realize", on_realize)
    w.set_default_size(64, 64)
    w.set_child(gl)
    w.present()
    # force map
    GLib.timeout_add(50, lambda: (gl.queue_render(), False)[1])

app.connect("activate", activate)
GLib.timeout_add(2500, app.quit)
code = app.run([])
if ok["err"]:
    print("probe err:", ok["err"], file=sys.stderr)
print("probe ok=", ok["v"], "GDK_BACKEND=", os.environ.get("GDK_BACKEND"), file=sys.stderr)
sys.exit(0 if ok["v"] else 1)
PY
  then
    return 0
  fi
  log "  probe failed (see $logf)"
  return 1
}

pick_gl_mode() {
  # Prints env KEY=VAL… including SOUNDORBIT_GL_MODE=…
  local forced="${SOUNDORBIT_GL_MODE:-${SOUNDORBIT_GL:-auto}}"
  local soft
  soft="$(software_gl_env)"
  case "$forced" in
    x11|x11-clean)
      echo "SOUNDORBIT_GL_MODE=x11-clean GDK_BACKEND=x11"
      return
      ;;
    nvidia-x11|nvidia)
      echo "SOUNDORBIT_GL_MODE=nvidia-x11 GDK_BACKEND=x11 __GLX_VENDOR_LIBRARY_NAME=nvidia"
      return
      ;;
    wayland)
      echo "SOUNDORBIT_GL_MODE=wayland GDK_BACKEND=wayland"
      return
      ;;
    software|llvmpipe)
      echo "$soft"
      return
      ;;
  esac

  local candidates=()
  local nv_wl
  nv_wl="$(nvidia_wayland_env)"
  if [[ "$GPU_PRIMARY" == "NVIDIA" ]]; then
    # Prefer native Wayland+NVIDIA first; probe is advisory — if all fail, still launch nv-wayland
    candidates+=(
      "$nv_wl"
      "SOUNDORBIT_GL_MODE=nvidia-egl SOUNDORBIT_ALPHA=0 __GLX_VENDOR_LIBRARY_NAME=nvidia __GL_THREADED_OPTIMIZATIONS=1"
      "SOUNDORBIT_GL_MODE=nvidia-prime SOUNDORBIT_ALPHA=0 __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia GDK_BACKEND=wayland"
      "SOUNDORBIT_GL_MODE=default SOUNDORBIT_ALPHA=0"
      "SOUNDORBIT_GL_MODE=nvidia-x11 SOUNDORBIT_ALPHA=0 GDK_BACKEND=x11 __GLX_VENDOR_LIBRARY_NAME=nvidia"
      "SOUNDORBIT_GL_MODE=x11-clean SOUNDORBIT_ALPHA=0 GDK_BACKEND=x11"
      "SOUNDORBIT_GL_MODE=mesa-wayland SOUNDORBIT_ALPHA=0 GDK_BACKEND=wayland __GLX_VENDOR_LIBRARY_NAME=mesa"
      "$soft"
    )
  else
    candidates+=(
      "SOUNDORBIT_GL_MODE=default"
      "SOUNDORBIT_GL_MODE=x11-clean GDK_BACKEND=x11"
      "$soft"
    )
  fi

  # Honor previously successful mode first
  if [[ -f "$DATA_DIR/gl_mode.ok" ]]; then
    local saved pre=()
    saved="$(tr -d '[:space:]' <"$DATA_DIR/gl_mode.ok" || true)"
    if [[ -n "$saved" ]]; then
      case "$saved" in
        nvidia-x11)
          pre+=("SOUNDORBIT_GL_MODE=nvidia-x11 GDK_BACKEND=x11 __GLX_VENDOR_LIBRARY_NAME=nvidia")
          ;;
        nvidia-wayland)
          pre+=("SOUNDORBIT_GL_MODE=nvidia-wayland GDK_BACKEND=wayland __GLX_VENDOR_LIBRARY_NAME=nvidia")
          ;;
        x11-clean|x11)
          pre+=("SOUNDORBIT_GL_MODE=x11-clean GDK_BACKEND=x11")
          ;;
        software)
          pre+=("$soft")
          ;;
        *)
          pre+=("SOUNDORBIT_GL_MODE=$saved")
          ;;
      esac
      candidates=("${pre[@]}" "${candidates[@]}")
    fi
  fi

  local mode
  for mode in "${candidates[@]}"; do
    log "GL probe: $mode"
    # shellcheck disable=SC2086
    if probe_gl $mode; then
      echo "$mode"
      return
    fi
  done
  # IMPORTANT: probes can false-fail under AppImage; do not strand NVIDIA on software only
  if [[ "$GPU_PRIMARY" == "NVIDIA" ]]; then
    log "GL probe all failed → launch nvidia-wayland anyway (in-app autofix will cycle)"
    echo "$nv_wl"
  else
    log "GL probe all failed → software+mesa fallback"
    echo "$soft"
  fi
}

# --------------- main ---------------
[[ -f "$APP_ROOT/sound-orbit" ]] || die "App payload missing ($APP_ROOT)"
mkdir -p "$DATA_DIR"

NEED_SETUP=0
if [[ ! -f "$SETUP_STAMP" ]] || [[ "${SOUNDORBIT_FORCE_SETUP:-0}" == "1" ]]; then
  NEED_SETUP=1
fi

if [[ "$NEED_SETUP" -eq 1 ]] || ! host_python_ok || ! command -v parec >/dev/null 2>&1; then
  log "setup: host packages for GPU [$GPU_ALL]"
  install_host_deps || log "warning: package install had errors (continuing)"
fi

if ! host_python_ok; then
  log "retry package install…"
  install_host_deps || true
fi
host_python_ok || die "GTK4 / PyGObject still missing after install"

ensure_venv
if ! venv_deps_ok; then
  log "venv broken → reinstall packages + venv"
  install_host_deps || true
  rm -f "$STAMP_FILE"
  ensure_venv
  venv_deps_ok || die "venv still broken"
fi

if ! command -v parec >/dev/null 2>&1; then
  log "warning: parec missing — trying pipewire-pulse again"
  install_host_deps || true
fi

# App menu always (idempotent)
if [[ "${SOUNDORBIT_NO_MENU:-0}" != "1" ]]; then
  install_app_menu
fi

printf '%s\n' "$(app_version)|$GPU_PRIMARY|$(date -Iseconds 2>/dev/null || date)" >"$SETUP_STAMP"

apply_gpu_env
export PYTHONNOUSERSITE=1
export SOUNDORBIT_GPU_PRIMARY="$GPU_PRIMARY"
export SOUNDORBIT_GPU_ALL="$GPU_ALL"

PY="$VENV_DIR/bin/python"
APP="$APP_ROOT/sound-orbit"

# Auto-pick GL mode / autofix
GL_ENV="$(pick_gl_mode)"
log "launch GPU=$GPU_PRIMARY GL=[${GL_ENV:-default}]"

# shellcheck disable=SC2086
if [[ -n "$GL_ENV" ]]; then
  exec env $GL_ENV "$PY" "$APP" "$@"
else
  exec "$PY" "$APP" "$@"
fi
